# API (unified backend — all routes served on one port)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8001
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/equity_research

# Redis (optional)
# REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# LLM
# Provider: ollama | deepseek | openai | groq
LLM_PROVIDER=ollama
# Global model override (optional). If unset, provider-specific default model is used.
# LLM_MODEL=deepseek-r1:8b
# Optional comma-separated discoverable model list for your own tooling/UI.
# LLM_MODEL_OPTIONS=deepseek-r1:8b,llama3.2,gemma2:9b,llama-3.3-70b-versatile,gpt-4o-mini
# Default temperature for chat model selection
LLM_TEMPERATURE=0.3

# Ollama
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_BASE_URL=http://localhost:11434

# DeepSeek API (optional, use LLM_PROVIDER=deepseek)
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI (optional, use LLM_PROVIDER=openai)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Groq API (optional, use LLM_PROVIDER=groq)
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini API (optional, used for supplemental company enrichment)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Embeddings (Ollama nomic-embed-text)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0

# Deep multi-agent orchestration
WORKFLOW_RUNS_DIR=workflow_runs
DEEP_AGENT_MAX_STEPS=6

# Optional web search augmentation (used by WebSearchAgent)
# TAVILY_API_KEY=tvly-...

# ── External data API keys (optional) ──
# Financial Modeling Prep — https://financialmodelingprep.com/developer/docs/
# FMP_API_KEY=your_fmp_api_key_here

# Alpha Vantage — https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Federal Reserve Economic Data (FRED) — https://fredaccount.stlouisfed.org/apikeys
# FRED_API_KEY=your_fred_api_key_here

# NewsAPI — https://newsapi.org/register
# NEWS_API_KEY=your_newsapi_key_here

# NewsData.io — https://newsdata.io/register
# NEWSDATA_API_KEY=your_newsdata_api_key_here

# News NLP models (Hugging Face)
# Default is a balanced setup: finance-specific sentiment + lightweight zero-shot classifier.
# NEWS_SENTIMENT_MODEL=ProsusAI/finbert
# NEWS_ZERO_SHOT_MODEL=typeform/distilbert-base-uncased-mnli
# For lighter sentiment (non-finance tuned), you can use:
# NEWS_SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# Upstox — https://developer.upstox.com/
# UPSTOX_API_KEY=your_upstox_api_key_here
# UPSTOX_API_SECRET=your_upstox_api_secret_here
# UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# Kite Connect (Zerodha) — https://developers.kite.trade/
# KITE_API_KEY=your_kite_api_key_here
# KITE_API_SECRET=your_kite_api_secret_here
# KITE_ACCESS_TOKEN=your_kite_access_token_here

# ── Round 2: Authentication / JWT ──
# REQUIRED in any non-dev deployment. Generate a real secret with:
#   openssl rand -hex 32
AUTH_JWT_SECRET=dev-only-change-me-in-production-please-do-not-ship-this
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_EMAIL_VERIFY_TOKEN_HOURS=24
AUTH_PASSWORD_RESET_TOKEN_MINUTES=30
# When true, login is blocked until /auth/verify-email is consumed.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# slowapi rate limits — applied per remote IP.
AUTH_LOGIN_RATE_LIMIT=5/minute
AUTH_SIGNUP_RATE_LIMIT=3/minute
AUTH_FORGOT_RATE_LIMIT=3/minute

# ── Round 2: Email sender (verify + reset emails) ──
# stub: log the verify/reset URL to stdout (dev default — no real send).
# smtp: send via SMTP_HOST/PORT/USERNAME/PASSWORD.
# ses:  send via AWS SES (uses SES_REGION or AWS_REGION).
EMAIL_SENDER=stub
EMAIL_FROM=no-reply@equityai.local
# Frontend base URL the user will be redirected to from email links.
EMAIL_APP_BASE_URL=http://localhost:5173
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SES_REGION=ap-south-1

# ── Round 2: Feature flags ──
# Vision-LLM chart extraction during PDF ingestion. Off by default — costly.
ENABLE_CHART_EXTRACTION=false
