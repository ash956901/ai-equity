# Financial Modeling Prep API Key
# Get your free API key at: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your_fmp_api_key_here

# Federal Reserve Economic Data (FRED) API Key
# Get your FREE API key at: https://fredaccount.stlouisfed.org/apikeys
# No rate limits, 700,000+ economic time series!
FRED_API_KEY=your_fred_api_key_here

# NewsAPI Key
# Get your free API key at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# NewsData.io API Key
# Get your free API key at: https://newsdata.io/register
NEWSDATA_API_KEY=your_newsdata_api_key_here

# Upstox API Credentials
# Register your app at: https://developer.upstox.com/
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
# Access token is obtained after completing the OAuth2 flow
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# Kite Connect (Zerodha) API Credentials
# Register your app at: https://developers.kite.trade/
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
# Access token is obtained after completing the Kite OAuth2 login flow
KITE_ACCESS_TOKEN=your_kite_access_token_here
